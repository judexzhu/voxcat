# Voxcat Configuration

voice:
  mode: "split" # "live" = all-in-one Gemini Live, "split" = separate STT + LLM + TTS
  live:
    model: "gemini-3.1-flash-live-preview"
    voice: "Aoede" # Options: Puck, Charon, Kore, Fenrir, Aoede
  split:
    stt_model: "gemini-3.5-transcribe-live"
    llm_model: "gemini-3.7-flash"
    tts_model: "gemini-3.1-flash-tts-preview"
    tts_voice: "Aoede" # Options: Puck, Charon, Kore, Fenrir, Aoede
    # tts_style: "extremely fast" # Options: extremely fast, whispering, shouting, sarcasm, robotic. Remove for default.

# Model used by deep_analysis, research, and summarize_session tools
tools:
  analysis_model: "gemini-3.7-flash"
  thinking_budget: 8192

# MCP servers — add your own here. Each server needs: command, args, cwd, env_keys, read_only_tools.
# Example:
#   my-server:
#     command: "uv"
#     args: ["run", "python", "-m", "my_mcp_server"]
#     cwd: "/path/to/my-mcp-server"
#     env_keys: [MY_API_TOKEN]
#     read_only_tools:
#       - search_items
#       - get_item
mcp_servers: {}

persona:
  default: "thinking-partner"
  profiles:
    thinking-partner:
      label: "Thinking Partner"
      description: "Probing questions, challenged assumptions, two sentences at a time."
      greeting: "What's on your mind?"
      instruction: |
        You are a brainstorming partner. Be short, concise, no filler. Directly to the key points with 2 or 3 sentences max.
        Ask questions to clarify if only need. Challenge assumptions constructively. Suggest connections between ideas.
        When the user seems stuck, offer a different angle.
      tools:
        builtin:
          [
            websearch,
            web_read,
            file_read,
            file_write,
            file_list,
            set_topic,
            summarize_session,
            get_current_time,
            deep_analysis,
            research,
            notebooklm_sync,
          ]
        mcp_servers: []
      output:
        directory: "output/thinking-partner"
    devils-advocate:
      label: "Devil's Advocate"
      description: "Attacks your idea until it breaks or holds."
      greeting: "Alright, pitch me something. I'll find the holes."
      instruction: |
        You attack ideas to find where they break. Under 30 words per turn.

        Every turn does exactly one of:
        - Name a specific failure mode and the condition that triggers it
        - Ask the one question whose answer would kill the idea
        - Concede: say the idea holds, and name what convinced you

        Concede when you have pressed twice and found nothing structural.
        A conceded point stays conceded. Do not relitigate it later.

        Never hedge. Never soften with "that said". Never object to a
        detail when you have no objection to the core.

        Attack the idea, never the user.
      tools:
        builtin:
          [
            websearch,
            web_read,
            file_read,
            file_write,
            file_list,
            set_topic,
            summarize_session,
            get_current_time,
            deep_analysis,
            research,
            notebooklm_sync,
          ]
        mcp_servers: []
      output:
        directory: "output/devils-advocate"
    note-taker:
      label: "Note Taker"
      description: "Stays quiet, writes down what you say."
      silent: true # No TTS output — listen-only mode. If mode is "live", auto-switches to "split".
      instruction: |
        You are a structured note-taker. Listen-only mode.
        Do NOT respond to the user unless they directly ask you a question.
        Silently organize what you hear into structured notes: bullet points, grouped by topic.
        Periodically save notes using file_write without being asked — every 2-3 minutes or when a topic changes.
        When the user says "read back" or "what do you have", then speak.
        Flag ambiguity with inline markers like (Ambiguity: unclear term).
      tools:
        builtin:
          [
            file_read,
            file_write,
            file_list,
            set_topic,
            get_current_time,
            summarize_session,
          ]
        mcp_servers: []
      output:
        directory: "output/note-taker"
    sre:
      label: "SRE Assistant"
      description: "Cases, KCS and Jira, read-only. Summarises findings."
      greeting: "SRE mode. What are we looking at?"
      instruction: |
        You are a Platform SRE voice assistant. 1-2 sentences max per response.
        SRE-SPECIFIC RULES:
        - User mentions a case number → call get_case with it.
        - User says "search cases" or describes a problem → call search_cases or search_kcs.
        - User mentions a Jira ticket → call jira_get_issue.
        - User says "search Jira" → call jira_search_issues with JQL.
        - When saving, use structured case report format.
        Evidence first. Never speculate. Name the tool you're calling.
      tools:
        builtin:
          [
            websearch,
            web_read,
            file_read,
            file_write,
            file_list,
            set_topic,
            summarize_session,
            get_current_time,
            deep_analysis,
            research,
            notebooklm_sync,
          ]
        mcp_servers: []  # add your MCP server names here
      output:
        directory: "output/sre"

server:
  host: "0.0.0.0"
  port: 7860
